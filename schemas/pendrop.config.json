{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://pendrop.io/schemas/pendrop.config.json",
  "title": "Pendrop Configuration Schema",
  "description": "Schema for pendrop.yml configuration file",
  "type": "object",
  "definitions": {
    "step": {
      "type": "object",
      "properties": {
        "description": {
          "type": "string"
        },
        "dependencies": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "prompt": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "task": {
      "type": "object",
      "properties": {
        "description": {
          "type": "string"
        },
        "step": {
          "type": "string"
        },
        "prompt": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "workflow": {
      "type": "object",
      "properties": {
        "source": {
          "type": "string",
          "description": "Path to a base workflow file to inherit from"
        },
        "variables": {
          "type": "object"
        },
        "assets": {
          "type": "object"
        },
        "steps": {
          "type": "object",
          "patternProperties": {
            "^.*$": {
              "$ref": "#/definitions/step"
            }
          }
        },
        "tasks": {
          "type": "object",
          "patternProperties": {
            "^.*$": {
              "$ref": "#/definitions/task"
            }
          }
        },
        "rules": {
          "type": "object"
        }
      },
      "additionalProperties": false
    }
  },
  "properties": {
    "variables": {
      "type": "object",
      "description": "Global variables"
    },
    "assets": {
      "type": "object",
      "description": "Global assets"
    },
    "workflows": {
      "type": "object",
      "description": "Workflow definitions",
      "patternProperties": {
        "^.*$": {
          "$ref": "#/definitions/workflow"
        }
      }
    },
    "design": {
      "type": "object",
      "description": "Design source configuration"
    },
    "rules": {
      "type": "object",
      "description": "Custom rules configuration"
    }
  },
  "additionalProperties": false
}
