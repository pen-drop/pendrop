# Penpot authentication
PENPOT_USERNAME=your_penpot_username_here
PENPOT_PASSWORD=your_penpot_password_here

# Penpot API base URL (change if using self-hosted Penpot)
PENPOT_API_URL=https://design.penpot.app/api

# Server configuration
PORT=5000
DEBUG=true

# HTTP server for images (set to false to disable)
ENABLE_HTTP_SERVER=true
HTTP_SERVER_HOST=localhost
HTTP_SERVER_PORT=0

# Resources as tools mode (set to false to use resources)
RESOURCES_AS_TOOLS=false

# MCP mode (stdio or sse)
MODE=stdio

